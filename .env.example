# =============================================================================
#  MathViz — Environment Configuration
# =============================================================================
#  Copy this file to .env and fill in your values:
#     cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED: Google AI API Key
# Get yours at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# ---------------------------------------------------------------------------
# Optional: Gemini model overrides
#
#   GEMINI_MODEL       — math_solver_agent only
#                        Default: gemini-2.5-pro  (accuracy matters for solving)
#
#   ANIMATION_MODEL    — animation_agent (largest token spend — code generation)
#                        Default: gemini-2.5-flash  (10x cheaper than pro, great at code)
#                        Override to gemini-2.5-pro only if animation quality is poor.
#
#   FAST_MODEL         — story_agent + solution_writer_agent
#                        Default: gemini-2.0-flash
#
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-pro
# ANIMATION_MODEL=gemini-2.5-flash
# FAST_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Optional: Manim render quality (applies globally to all renders)
# Options: l=480p15  m=720p30  h=1080p60 (default)  p=1440p60  k=2160p60
# Higher quality = longer render time:
#   l = ~15-30 s   m = ~45-90 s   h = ~3-5 min (default)   k = ~10-15 min
# Use h for standard production. Use k for final export / showcase only.
# ---------------------------------------------------------------------------
# MANIM_QUALITY=h

# ---------------------------------------------------------------------------
# Optional: Output directories (defaults shown)
# ---------------------------------------------------------------------------
# SOLUTIONS_DIR=outputs/solutions
# ANIMATIONS_DIR=outputs/animations
