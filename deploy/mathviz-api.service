[Unit]
Description=MathViz FastAPI Backend
After=network.target

[Service]
User=mathviz
WorkingDirectory=/opt/mathviz
EnvironmentFile=/opt/mathviz/.env
ExecStart=/opt/mathviz/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
